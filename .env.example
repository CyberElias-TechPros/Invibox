# Frontend (Vercel). Keep relative when Vercel rewrites /api to the Worker.
VITE_API_BASE=/api/v1

# Cloudflare Worker non-secret variables
APP_ENV=development
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
EMAIL_FROM=Invibox <events@your-verified-domain.com>
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=event_update
WHATSAPP_TEMPLATE_LANGUAGE=en
TWILIO_FROM_NUMBER=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Secrets — use `wrangler secret put NAME`; never commit real values
# SESSION_PEPPER=
# MFA_ENCRYPTION_KEY=  # Independent random secret (32+ characters); keep stable and back up securely.
# RESEND_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# AI_API_KEY=
# PAYSTACK_SECRET_KEY=

# Production non-secret setup (see npm run configure:production)
# INVIBOX_APP_ORIGIN=https://your-frontend-domain
# INVIBOX_API_ORIGIN=https://your-worker-domain
# CLOUDFLARE_D1_ID=
# CLOUDFLARE_KV_ID=
# R2_BUCKET=invibox-media
# QUEUE_NAME=invibox-notifications

# Development bindings live in wrangler.toml; generated production bindings in wrangler.production.toml
# D1 database_id, R2 bucket_name, KV id, Queue producer/consumer name
