# Frontend (Vercel). Keep relative when Vercel rewrites /api to the Worker.
VITE_API_BASE=/api/v1

# Cloudflare Worker non-secret variables
APP_ENV=development
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
EMAIL_FROM=Invibox <events@your-verified-domain.com>
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=event_update
WHATSAPP_TEMPLATE_LANGUAGE=en
TWILIO_FROM_NUMBER=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Secrets — use `wrangler secret put NAME`; never commit real values
# SESSION_PEPPER=
# RESEND_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# AI_API_KEY=
# PAYSTACK_SECRET_KEY=

# Cloudflare resource IDs belong in worker/wrangler.toml
# D1 database_id, R2 bucket_name, KV id, Queue producer/consumer name
